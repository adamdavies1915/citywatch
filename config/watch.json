{
  "lookback_days": 45,
  "lookahead_days": 60,
  "timeout_seconds": 30,
  "max_download_bytes": 25000000,
  "max_documents_per_run": 350,
  "max_news_pages": 3,
  "sources": [
    "council",
    "legistar",
    "planning",
    "council_news",
    "mayor_news",
    "public_works_news"
  ],
  "rules": [
    {
      "id": "cycling",
      "priority": "direct",
      "exclude_patterns": [
        "\\b(?:shoes|blankets|grill|tents|debris|trash)(?:,\\s*[\\w -]+){0,5},\\s*bikes?\\b(?!\\s+(?:lanes?|racks?|parking|paths?|safety|sharing|infrastructure)\\b)"
      ],
      "pattern": "\\b(?:bicycles?|bikes?|e[ -]?bikes?|bikeways?|cycling|cycle tracks?|bike[ -]sharing)\\b"
    },
    {
      "id": "walking",
      "priority": "direct",
      "exclude_document_titles": ["\\bdrone flight logs?(?=[_\\W]|$)"],
      "exclude_patterns": [
        "\\broof\\s+walkway pads?\\b",
        "\\bwalkway pad detail roof\\b"
      ],
      "pattern": "\\b(?:pedestrians?|sidewalks?|walkways?|walkability|crosswalks?|curb ramps?|walking paths?)\\b"
    },
    {
      "id": "safe_streets",
      "priority": "direct",
      "pattern": "\\b(?:complete streets|traffic calming|safe routes|vision zero|road diets?|protected lanes?|shared[ -]use paths?)\\b"
    },
    {
      "id": "greenways",
      "priority": "direct",
      "exclude_patterns": [
        "\\b\\d+\\s+(?:east\\s+)?greenway plaza\\b",
        "\\bgreenway corridor\\s+others? as required\\b"
      ],
      "pattern": "\\bgreenways?\\b"
    },
    {
      "id": "transit",
      "priority": "direct",
      "pattern": "\\b(?:public transit|public transportation|fare[ -]free|bus (?:lanes?|stops?|routes?|service)|streetcars?|transit (?:center|service|access)|opportunity pass)\\b"
    },
    {
      "id": "autonomous_vehicles",
      "priority": "direct",
      "exclude_patterns": ["\\bautomated vehicle location\\b"],
      "pattern": "\\b(?:waymo|robo[ -]?taxis?|(?:autonomous|driverless|self[ -]driving|automated) (?:motor |for[ -]hire )?(?:vehicles?|cars?|taxis?)|automated driving systems?)\\b"
    },
    {
      "id": "land_use",
      "priority": "policy",
      "exclude_patterns": [
        "\\bany zoning text(?: or map)? amendments? are matters of legislative discretion\\b"
      ],
      "pattern": "\\b(?:parking (?:minimums?|requirements?)|transfer of development rights?|zoning text(?: amendments?)?|transit[ -]oriented (?:development|communities)|housing density|density bonuses?|upzoning)\\b"
    },
    {
      "id": "watched_projects",
      "priority": "direct",
      "pattern": "\\b(?:lafitte greenway|connecting new orleans east|downtown transit center)\\b"
    }
  ],
  "ocr": true
}

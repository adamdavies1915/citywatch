{
  "display_information": {
    "name": "CityWatch",
    "description": "Daily New Orleans policy updates with official sources",
    "background_color": "#126748"
  },
  "features": {
    "bot_user": {
      "display_name": "CityWatch",
      "always_online": false
    }
